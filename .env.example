# Safe local placeholders only. Copy to .env (ignored by git); never commit real secrets.

# Direct pnpm development (services on the host):
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://atmos:atmos@localhost:5432/atmos
REDIS_URL=redis://localhost:6379

# Compose values (container hostnames) are set in compose.yaml:
#   DATABASE_URL=postgresql://atmos:atmos@postgres:5432/atmos
#   REDIS_URL=redis://redis:6379
#   API_PROXY_TARGET=http://api:3000   (web dev server, server-side only)
