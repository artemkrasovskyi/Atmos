{
  "$schema": "https://turborepo.dev/schema.json",
  "globalPassThroughEnv": ["NODE_ENV", "PORT", "DATABASE_URL", "REDIS_URL", "API_PROXY_TARGET"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "build/**"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "clean": {
      "cache": false
    }
  }
}
